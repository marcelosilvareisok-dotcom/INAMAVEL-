# GEMINI_API_KEY: Required for Gemini AI API calls.
# In AI Studio, this is automatically injected.
# Outside, you can use VITE_GEMINI_API_KEY for client-side access.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# MERCADO_PAGO_ACCESS_TOKEN: Required for Mercado Pago payment integration.
# Get this from your Mercado Pago dashboard (https://www.mercadopago.com.br/developers/panel/credentials)
MERCADO_PAGO_ACCESS_TOKEN=
VITE_MERCADO_PAGO_PUBLIC_KEY=

# FIREBASE CONFIGURATION (If not using firebase-applet-config.json)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# FIREBASE_SERVICE_ACCOUNT_KEY: Required for backend Firebase Admin access.
# Get this from your Firebase project settings (Service Accounts tab).
FIREBASE_SERVICE_ACCOUNT_KEY=
