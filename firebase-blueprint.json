{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and coin balance",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "coins": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "role": { "type": "string", "enum": ["user", "admin"] }
      },
      "required": ["uid", "email", "coins", "createdAt", "role"]
    },
    "Project": {
      "title": "Project",
      "description": "A website or app project created by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["website", "app", "landing", "service"] },
        "objective": { "type": "string" },
        "content": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "slug": { "type": "string" },
        "githubUrl": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "isForSale": { "type": "boolean" },
        "price": { "type": "number" }
      },
      "required": ["id", "userId", "name", "type", "content", "status", "createdAt", "updatedAt", "slug"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Coin purchase or spending history",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["purchase", "spend"] },
        "description": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "amount", "type", "description", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a project",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "projectId", "userId", "authorName", "text", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/transactions/{transactionId}": {
      "schema": "Transaction",
      "description": "Coin transactions"
    },
    "/projects/{projectId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments on a project"
    }
  }
}
